# Copiar a .env y completar valores. NUNCA commitear .env con valores reales.

SECRET_KEY=cambiar-por-clave-segura-de-50-chars
DEBUG=False
ALLOWED_HOSTS=srni.unidadvictimas.gov.co

# Base de datos
DB_NAME=srni_db
DB_USER=srni_app
DB_PASSWORD=CAMBIAR_PASSWORD_SEGURO
DB_HOST=localhost
DB_PORT=5432
DB_SSL_MODE=require

# Cifrado de campos PII (AES-256, 32 bytes en base64)
FIELD_ENCRYPTION_KEY=CAMBIAR_CLAVE_CIFRADO_BASE64

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=CAMBIAR_PASSWORD_REDIS

# MinIO / S3 (para documentos soporte)
MINIO_ENDPOINT=https://minio.srni.interno
MINIO_ACCESS_KEY=CAMBIAR
MINIO_SECRET_KEY=CAMBIAR
MINIO_BUCKET=srni-docs

# CORS
CORS_ALLOWED_ORIGINS=https://srni.unidadvictimas.gov.co

# IA Gemini — requerido para el módulo de asistente de voz e IA batch
# Obtener en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=CAMBIAR_POR_CLAVE_API_GEMINI

# Oracle legacy LOCAL (Docker gvenzl/oracle-free) — SOLO validación de paridad.
# Nunca apuntar a producción (30.0.1.9). Ver infra/oracle-local/ y
# docs/oracle-legacy/oracle-local-setup.md.
ORACLE_LEGACY_HOST=localhost
ORACLE_LEGACY_PORT=1521
ORACLE_LEGACY_SERVICE=FREEPDB1
ORACLE_LEGACY_USER=RNIENTREVISTA
ORACLE_LEGACY_PASSWORD=CAMBIAR_PASSWORD_LOCAL
