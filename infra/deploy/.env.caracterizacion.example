# ============================================================
# SRNI Caracterización — Variables de entorno del despliegue
# ------------------------------------------------------------
# Copiar a `.env` en la raíz del proyecto en el servidor.
# Los valores reales (claves, passwords) los GENERA el script
# scripts/10-generar-secrets.sh — NO commitear el .env real.
# ============================================================

# --- PostgreSQL (interno al stack) ---
DB_NAME=srni_caracterizacion
DB_USER=srni_app
DB_PASSWORD=GENERAR

# --- Django ---
SECRET_KEY=GENERAR
# Cifrado de campos PII (AES-256, 32 bytes en base64 url-safe)
FIELD_ENCRYPTION_KEY=GENERAR
# IP del servidor + locales. Django ignora el puerto al validar el Host.
ALLOWED_HOSTS=30.0.1.109,localhost,127.0.0.1
# Orígenes públicos por los que se entra (CORS + CSRF del /admin/). Incluir TODOS
# los que se usen: IP:puerto, túnel ngrok y/o el dominio definitivo de la OTI.
CORS_ALLOWED_ORIGINS=https://prod-caracterizacion.ngrok.app,http://30.0.1.109:8090

# --- Redis ---
REDIS_PASSWORD=GENERAR

# --- IA Gemini (opcional; el asistente de voz queda inactivo si va vacío) ---
GEMINI_API_KEY=
