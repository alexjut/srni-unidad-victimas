# ============================================================
# SRNI Caracterización — Variables de entorno del despliegue
# ------------------------------------------------------------
# Copiar a `.env` en la raíz del proyecto en el servidor.
# Los valores reales (claves, passwords) los GENERA el script
# scripts/10-generar-secrets.sh — NO commitear el .env real.
# ============================================================

# --- PostgreSQL (interno al stack) ---
DB_NAME=srni_caracterizacion
DB_USER=srni_app
DB_PASSWORD=GENERAR

# --- Django ---
SECRET_KEY=GENERAR
# Cifrado de campos PII (AES-256, 32 bytes en base64 url-safe)
FIELD_ENCRYPTION_KEY=GENERAR
# IP del servidor + locales. Django ignora el puerto al validar el Host.
ALLOWED_HOSTS=30.0.1.109,localhost,127.0.0.1,.unidadvictimas.gov.co,.ngrok.app
# Orígenes públicos por los que se entra (CORS + CSRF del /admin/). Incluir TODOS
# los que se usen: IP:puerto, túnel ngrok y/o el dominio definitivo de la OTI.
CORS_ALLOWED_ORIGINS=https://caracterizacion.unidadvictimas.gov.co,https://prod-caracterizacion.ngrok.app,http://30.0.1.109:8090

# --- Redis ---
REDIS_PASSWORD=GENERAR

# --- IA Gemini (opcional; el asistente de voz queda inactivo si va vacío) ---
GEMINI_API_KEY=

# --- Oracle legacy de la UARIV (30.0.1.9 / ENTREVISTARN) ---
# Lo usan la carga del padrón (`cargar_padron_oracle`) y el disparador que
# sincroniza cada hogar caracterizado hacia los procedures GIC_*.
# Si van vacíos, el backend web funciona igual: lo que queda inactivo es la
# carga del padrón y la escritura hacia el legacy.
ORACLE_PROD_HOST=30.0.1.9
ORACLE_PROD_PORT=1521
ORACLE_PROD_SERVICE=ENTREVISTARN
ORACLE_PROD_USER=
ORACLE_PROD_PASSWORD=

# --- Escritura automática hacia el Oracle legacy ---
# Apagada por defecto: escribir en la base de la UARIV es irreversible (los
# procedures hacen COMMIT interno). Encenderla es una decisión operativa.
ORACLE_SYNC_AUTOMATICA=False
ORACLE_SYNC_DESTINO=          # 'produccion' | 'local'

# ============================================================
# Tareas programadas (celery beat — contenedor cz_beat)
# ------------------------------------------------------------
# Las dos APAGADAS por defecto. Cambiar cualquiera de estas variables solo exige
# editar este archivo y `docker compose up -d cz_beat cz_celery_padron`: NO hay
# que reconstruir la imagen ni desplegar, porque el schedule las lee del entorno.
# ============================================================

# --- 1. Recarga del padrón ---
# Cadena completa: cargar_padron_oracle --confirmar (idempotente, NUNCA
# --carga-inicial) → cargar_fechas_caracterizacion --confirmar → generar_padron.
#
# ⚠️ Dura del orden de un DÍA: la variante idempotente hace update_or_create fila a
# fila (~51 filas/s medidos sobre 5,9 M de personas). Por eso es mensual y por eso
# arranca en fin de semana. Dos corridas no pueden solaparse: hay un bloqueo en
# Redis que hace que la segunda se saltee.
PADRON_RECARGA_HABILITADA=False
PADRON_RECARGA_HORA=20             # hora local (America/Bogota)
PADRON_RECARGA_DIA_SEMANA=saturday
PADRON_RECARGA_DIAS_MES=1-7        # con el día de semana ⇒ el PRIMER sábado del mes
# Refresco diario: solo fechas + SQLite (~15 min). Es lo que evita que la APK
# ofrezca recaracterizar a alguien que la aplicación legacy atendió ayer.
PADRON_REFRESCO_HORA=3

# --- 2. Reintento de la sincronización a Oracle ---
# Barre los hogares con la encuesta cerrada que quedaron sin escribirse (broker
# caído al cerrar, escritura apagada en ese momento, reintentos agotados, máquina
# de estados a medias) y los reencola. No hace nada si ORACLE_SYNC_AUTOMATICA=False.
SYNC_REINTENTO_HABILITADO=False
SYNC_REINTENTO_CADA_MINUTOS=15
SYNC_REINTENTO_LIMITE=50           # hogares por corrida
SYNC_REINTENTO_ENFRIAMIENTO=30     # minutos antes de reintentar algo que falló
SYNC_REINTENTO_MAX_INTENTOS=5      # a partir de aquí, requiere intervención manual
