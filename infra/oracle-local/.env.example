# Copiar a infra/oracle-local/.env y completar. NUNCA commitear el .env real.
# Solo se usa para el Oracle LOCAL de Docker (estructura, sin datos reales).

# Password de SYS/SYSTEM/PDBADMIN del contenedor.
ORACLE_SYS_PASSWORD=CAMBIAR_SYS_LOCAL

# Esquema destino del import (mismo nombre que producción para que el .dmp calce).
ORACLE_LEGACY_USER=RNIENTREVISTA
ORACLE_LEGACY_PASSWORD=CAMBIAR_RNIENT_LOCAL

# Puerto host expuesto (cambiar si 1521 está ocupado).
ORACLE_LEGACY_PORT=1521
